/* ~/Desktop/acropdf/resources/styles/light.qss */
QWidget { color: #1a1a1a; }
QMainWindow { background: #f0f0f0; }
QToolBar { background: #e8e8e8; border-bottom: 1px solid #ccc; spacing: 4px; padding: 2px; }
QToolBar QToolButton { padding: 4px 8px; border-radius: 4px; color: #1a1a1a; }
QToolBar QToolButton:checked { background: #0078d4; color: white; }
QToolBar QToolButton:hover { background: #d0e8ff; }
QScrollArea { background: #808080; }
QListWidget { background: #fafafa; color: #1a1a1a; border: 1px solid #ddd; }
QListWidget::item:selected { background: #0078d4; color: white; }
QTreeWidget { background: #fafafa; color: #1a1a1a; border: 1px solid #ddd; }
QTreeWidget::item:selected { background: #0078d4; color: white; }
QTabWidget::pane { border: 1px solid #ccc; }
QTabBar::tab { padding: 6px 12px; background: #e8e8e8; color: #1a1a1a; }
QTabBar::tab:selected { background: white; border-bottom: 2px solid #0078d4; color: #1a1a1a; }
QStatusBar { background: #e0e0e0; color: #333; }
QPushButton {
    padding: 6px 16px;
    border: 1px solid #999;
    border-radius: 4px;
    background: white;
    color: #1a1a1a;
}
QPushButton:hover { background: #e8f0fe; }
QPushButton:pressed { background: #cdd6e8; }
QPushButton:disabled { color: #999; }
QLineEdit {
    background: white;
    border: 1px solid #bbb;
    border-radius: 3px;
    color: #1a1a1a;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #0078d4; }
QComboBox { background: white; border: 1px solid #bbb; color: #1a1a1a; padding: 4px 8px; border-radius: 3px; }
QComboBox QAbstractItemView { background: white; color: #1a1a1a; selection-background-color: #0078d4; selection-color: white; }
QSpinBox, QDoubleSpinBox { background: white; border: 1px solid #bbb; color: #1a1a1a; padding: 3px; }
QGroupBox { border: 1px solid #ccc; border-radius: 4px; margin-top: 8px; color: #333; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; color: #555; }
QLabel { color: #1a1a1a; }
QDialog { background: #f5f5f5; }
QCheckBox { color: #1a1a1a; }
QProgressBar { border: 1px solid #bbb; border-radius: 3px; background: #f0f0f0; color: #333; text-align: center; }
QProgressBar::chunk { background: #0078d4; border-radius: 2px; }
QScrollBar:vertical { background: #f0f0f0; width: 12px; border-radius: 6px; }
QScrollBar::handle:vertical { background: #bbb; border-radius: 5px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #999; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #f0f0f0; height: 12px; border-radius: 6px; }
QScrollBar::handle:horizontal { background: #bbb; border-radius: 5px; min-width: 20px; }
QScrollBar::handle:horizontal:hover { background: #999; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
