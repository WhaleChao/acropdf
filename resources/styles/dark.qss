/* ~/Desktop/acropdf/resources/styles/dark.qss */
QWidget { color: #e8e8e8; }
QMainWindow { background: #1e1e1e; }
QToolBar { background: #2d2d2d; border-bottom: 1px solid #444; spacing: 4px; padding: 2px; }
QToolBar QToolButton { padding: 4px 8px; border-radius: 4px; color: #e8e8e8; }
QToolBar QToolButton:checked { background: #0078d4; color: white; }
QToolBar QToolButton:hover { background: #3a3a3a; }
QScrollArea { background: #3c3c3c; }
QListWidget { background: #252525; color: #e8e8e8; border: 1px solid #444; }
QListWidget::item:selected { background: #0078d4; color: white; }
QListWidget::item:hover { background: #333; }
QTreeWidget { background: #252525; color: #e8e8e8; border: 1px solid #444; }
QTreeWidget::item:selected { background: #0078d4; color: white; }
QTreeWidget::item:hover { background: #333; }
QTabWidget::pane { border: 1px solid #444; background: #1e1e1e; }
QTabWidget::tab-bar { alignment: left; }
QTabBar::tab { padding: 6px 12px; background: #2d2d2d; color: #e8e8e8; border: 1px solid #444; }
QTabBar::tab:selected { background: #1e1e1e; border-bottom: 2px solid #0078d4; color: white; }
QTabBar::tab:hover { background: #383838; }
QStatusBar { background: #2d2d2d; color: #ccc; border-top: 1px solid #444; }
QPushButton {
    padding: 6px 16px;
    border: 1px solid #555;
    border-radius: 4px;
    background: #3a3a3a;
    color: #e8e8e8;
}
QPushButton:hover { background: #4a4a4a; }
QPushButton:pressed { background: #2a2a2a; }
QPushButton:disabled { color: #666; background: #2d2d2d; }
QLineEdit {
    background: #2d2d2d;
    border: 1px solid #555;
    border-radius: 3px;
    color: #e8e8e8;
    padding: 4px;
}
QLineEdit:focus { border: 1px solid #0078d4; }
QComboBox {
    background: #2d2d2d;
    border: 1px solid #555;
    border-radius: 3px;
    color: #e8e8e8;
    padding: 4px 8px;
}
QComboBox QAbstractItemView { background: #2d2d2d; color: #e8e8e8; selection-background-color: #0078d4; }
QSpinBox, QDoubleSpinBox {
    background: #2d2d2d;
    border: 1px solid #555;
    color: #e8e8e8;
    padding: 3px;
}
QGroupBox {
    border: 1px solid #555;
    border-radius: 4px;
    margin-top: 8px;
    color: #e8e8e8;
}
QGroupBox::title { subcontrol-origin: margin; left: 8px; color: #aaa; }
QLabel { color: #e8e8e8; }
QDialog { background: #1e1e1e; }
QCheckBox { color: #e8e8e8; }
QCheckBox::indicator { border: 1px solid #555; background: #2d2d2d; border-radius: 2px; }
QCheckBox::indicator:checked { background: #0078d4; border-color: #0078d4; }
QProgressBar {
    border: 1px solid #555;
    border-radius: 3px;
    background: #2d2d2d;
    color: #e8e8e8;
    text-align: center;
}
QProgressBar::chunk { background: #0078d4; border-radius: 2px; }
QScrollBar:vertical { background: #2d2d2d; width: 12px; border-radius: 6px; }
QScrollBar::handle:vertical { background: #555; border-radius: 5px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #777; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #2d2d2d; height: 12px; border-radius: 6px; }
QScrollBar::handle:horizontal { background: #555; border-radius: 5px; min-width: 20px; }
QScrollBar::handle:horizontal:hover { background: #777; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QMenuBar { background: #2d2d2d; color: #e8e8e8; }
QMenuBar::item:selected { background: #3a3a3a; }
QMenu { background: #2d2d2d; color: #e8e8e8; border: 1px solid #444; }
QMenu::item:selected { background: #0078d4; color: white; }
QMenu::separator { background: #444; height: 1px; margin: 2px 8px; }
